# Copy this file to `.env.local` and adjust the values for your environment.
# All variables are NEXT_PUBLIC_* and are exposed to the browser — do not put
# secrets here.

# Base URL of the backend API. Uncomment the target you're developing against.
# Default if unset: http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api                          # local
# NEXT_PUBLIC_API_URL=https://pharmacy-backend-hmir.onrender.com/api   # hosted (Render)
# NEXT_PUBLIC_API_URL=http://evuze.ubwengelab.rw/api                   # Ubwenge Lab server

# Set to 'true' to expose the /patient/* portal.
# Default if unset: false. Locally, the `dev_mode` cookie also bypasses this
# (append ?dev_mode=true to any URL).
NEXT_PUBLIC_ENABLE_PATIENT_FEATURES=false

# Support contact surfaced in the UI.
# Default if unset: info@ubwengelab.rw
NEXT_PUBLIC_SUPPORT_EMAIL=info@ubwengelab.rw


